@entity(e-, diss, 0)
@logKreaction(e-, 0, 1.0, E)
@entity(C[-4], tot, 0)
@logKreaction(C[-4], "(( (1.0 / log(10)) * ((41.071 * log(10)) - (-255387.176 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", 1.0, C, 10.0, H+, -3.0, H2O, 8.0, e-)
@entity(H[+0], tot, 0)
