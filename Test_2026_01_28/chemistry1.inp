@gas(H2[g])
@logKreaction(H2[g], "-1 * (( (1.0 / log(10)) * ((-3.105 * log(10)) - (-4184.0 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", 1.0, H2)
@species(HCO3-, -1, 5.4, 0)
@logKreaction(HCO3-, "(( (1.0 / log(10)) * ((10.329 * log(10)) - (-14899.224 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", 1.0, CO3-2, 1.0, H+)
@entity(O[+0], tot, 0)
@logKreaction(O[+0], "(( (1.0 / log(10)) * ((-86.08 * log(10)) - (563961.36 / 8.3144598) * ((1 / @T()) - (1 / 298.15))) ))", -4.0, H+, 2.0, O, -4.0, e-)
@species(O2, 0)
