//********* The entities *******

@entity(C[+4], tot, 0)
@logKreaction(C[+4], 0, 1.0, C)
@species(CO3-2, -2, 5.4, 0)
@logKreaction(CO3-2, 0, 1.0, C[+4])
@entity(Alkalinity, tot, 0)
@logKreaction(Alkalinity, "-(0)", 1.0, CO3-2)
@entity(H[+1], tot, 0)
@logKreaction(H[+1], 0, 1.0, H)
@species(H+, 1, 9.0, 0)
@logKreaction(H+, 0, 1.0, H[+1])
@entity(O[-2], tot, 0)
@logKreaction(O[-2], 0, 1.0, O)
@entity(H2O, liter, 55.6)
